# UZA Build — environment template
# Copy to .env for local work. Never commit a real .env.
#
# Only the values below are safe to reach the browser. They are publishable
# keys: anything bundled into the frontend must be treated as public.
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
VITE_SUPABASE_PROJECT_ID="<project-ref>"

# Server-side equivalents, read only inside server functions (never in a
# component, never with a VITE_ prefix).
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
SUPABASE_PROJECT_ID="<project-ref>"

# Secrets are NOT kept in this file on Lovable Cloud. The service-role key,
# the AI gateway key and any third-party credential are stored in the hosted
# secret store and injected into server functions at runtime:
#   SUPABASE_SERVICE_ROLE_KEY   (managed, never exposed)
#   LOVABLE_API_KEY             (managed, never exposed)
#   ANTHROPIC_API_KEY           (managed, never exposed — drawing reading, quote parsing, translation)

# Speckle (speckle.systems) 3D/BIM rendering + comments — REQUIRED for the
# rendering panel, and currently UNSET in every environment this was built
# in. Without a token the feature degrades to a "not configured" message
# instead of breaking the app or the build. Create a personal access token
# at <server>/profile under Developer settings (least-privilege scopes) —
# see the provenance note at the top of src/lib/speckle.functions.ts.
SPECKLE_SERVER_URL="https://app.speckle.systems"
SPECKLE_API_TOKEN=""
